DCA_ADDR=127.0.0.1:27123
DCA_DATA_DIR=
DCA_TOKEN=
DCA_MAX_BODY_BYTES=10485760

DCA_AI_ENABLED=false
DCA_OPENAI_BASE_URL=https://api.openai.com/v1
DCA_OPENAI_API_KEY=
DCA_OPENAI_MODEL=
DCA_AI_CHUNK_CHARS=12000
DCA_AI_TIMEOUT_SECONDS=90

# 任何 OpenAI-compatible 的 /chat/completions 端点都可以（OpenAI、NVIDIA NIM、vLLM、本地服务器）。
# NVIDIA NIM 示例。google/diffusiongemma-26b-a4b-it 是多模态 TEXT-OUT：
# 能理解图片，但不会生成图片。不使用 /v1/images/generations。
# DCA_AI_ENABLED=true
# DCA_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# DCA_OPENAI_API_KEY=
# DCA_OPENAI_MODEL=google/diffusiongemma-26b-a4b-it
# DCA_AI_TIMEOUT_SECONDS=180
