DCA_ADDR=127.0.0.1:27123
DCA_DATA_DIR=
DCA_TOKEN=
DCA_MAX_BODY_BYTES=10485760

DCA_AI_ENABLED=false
DCA_OPENAI_BASE_URL=https://api.openai.com/v1
DCA_OPENAI_API_KEY=
DCA_OPENAI_MODEL=
DCA_AI_CHUNK_CHARS=12000
DCA_AI_TIMEOUT_SECONDS=90

# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, NVIDIA NIM, vLLM, local servers).
# NVIDIA NIM example. google/diffusiongemma-26b-a4b-it is multimodal TEXT-OUT:
# it understands images but does not generate them. /v1/images/generations is not used.
# DCA_AI_ENABLED=true
# DCA_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# DCA_OPENAI_API_KEY=
# DCA_OPENAI_MODEL=google/diffusiongemma-26b-a4b-it
# DCA_AI_TIMEOUT_SECONDS=180
